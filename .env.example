# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el .env.

DATABASE_URL="file:./pos.db"
PORT=4000

# JWT: clave secreta de al menos 32 caracteres. Generar una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración de la sesión (ej: 12h, 8h, 30m)
JWT_EXPIRES_IN=12h

# Impresora: "tcp" (red) o "serial" (USB/COM)
PRINTER_TYPE=tcp
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
PRINTER_PATH=COM3
PRINTER_BAUD=9600
PAPER_WIDTH=48

# Datos del comercio (aparecen en el ticket)
STORE_NAME=MI COMERCIO
STORE_ADDRESS=Calle 123, Ciudad
STORE_PHONE=(000) 000-0000
STORE_TAX_ID=00-00000000-0
TICKET_FOOTER=Gracias por su compra!

# Cobro con QR: "simulator" (pruebas, no entra dinero real) o vacío para deshabilitarlo.
# Próximamente: "mercadopago". El alias para transferencias se configura por local en Administración.
QR_PROVIDER=

# Administrador inicial: se crea solo si la base no tiene usuarios.
# Después del primer arranque se puede borrar ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-clave

# Interfaz de red: 127.0.0.1 = solo esta PC. En Docker se fuerza 0.0.0.0.
HOST=127.0.0.1
