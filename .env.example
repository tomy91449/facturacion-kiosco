# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el .env.

DATABASE_URL="file:./pos.db"
PORT=4000

# Impresora: "tcp" (red) o "serial" (USB/COM)
PRINTER_TYPE=tcp
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
PRINTER_PATH=COM3
PRINTER_BAUD=9600
PAPER_WIDTH=48

# Datos del comercio (aparecen en el ticket)
STORE_NAME=MI COMERCIO
STORE_ADDRESS=Calle 123, Ciudad
STORE_PHONE=(000) 000-0000
STORE_TAX_ID=00-00000000-0
TICKET_FOOTER=Gracias por su compra!

# Administrador inicial: se crea solo si la base no tiene usuarios.
# Después del primer arranque se puede borrar ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-clave
