# Configuración de Kiosco Domingo en esta PC.
# Después de cambiar algo, cerrá y volvé a abrir el programa.

# Impresora de tickets: "serial" (USB / puerto COM) o "tcp" (impresora de red)
PRINTER_TYPE=serial
PRINTER_PATH=COM3
PRINTER_BAUD=9600
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
# Caracteres por línea: 48 para papel de 80 mm, 32 para 58 mm
PAPER_WIDTH=48

# Datos del comercio (aparecen en el ticket)
STORE_NAME=MI COMERCIO
STORE_ADDRESS=Calle 123, Ciudad
STORE_PHONE=(000) 000-0000
STORE_TAX_ID=00-00000000-0
TICKET_FOOTER=Gracias por su compra!

# Duración de la sesión de cada usuario
JWT_EXPIRES_IN=12h

# Cobro con QR: vacío = deshabilitado, "simulator" = solo pruebas (no entra dinero)
QR_PROVIDER=
