generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Cada local del negocio. Toda la facturación queda asociada a un local.
model Store {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  address   String?
  phone     String?
  taxId     String?  @map("tax_id")
  active    Boolean  @default(true)
  // Datos para cobrar por transferencia: se muestran al cliente en la pantalla de cobro
  transferAlias  String?  @map("transfer_alias")
  transferHolder String?  @map("transfer_holder")
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]
  products  Product[]
  customers Customer[]
  sales     Sale[]
  paymentIntents PaymentIntent[]

  @@map("stores")
}

// role: "ADMIN" (dueño, sin local, ve todo) | "CASHIER" (atado a un local)
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("CASHIER")
  storeId      Int?     @map("store_id")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  store        Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id          Int        @id @default(autoincrement())
  storeId     Int        @map("store_id")
  barcode     String
  description String
  price       Float
  cost        Float
  stock       Int        @default(0)
  minStock    Int        @default(0) @map("min_stock")
  categoryId  Int?       @map("category_id")
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  store       Store      @relation(fields: [storeId], references: [id])
  category    Category?  @relation(fields: [categoryId], references: [id])
  saleItems   SaleItem[]

  // El mismo código de barras puede existir en distintos locales
  @@unique([storeId, barcode])
  @@index([categoryId])
  @@index([storeId, active, stock])
  @@map("products")
}

model Customer {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  name      String
  taxId     String?  @map("tax_id")
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  store     Store    @relation(fields: [storeId], references: [id])
  sales     Sale[]

  @@unique([storeId, taxId])
  @@map("customers")
}

model Sale {
  id            Int        @id @default(autoincrement())
  storeId       Int        @map("store_id")
  date          DateTime   @default(now())
  customerId    Int?       @map("customer_id")
  total         Float
  discount      Float      @default(0)
  tax           Float      @default(0)
  grandTotal    Float      @map("grand_total")
  paymentMethod String     @map("payment_method")
  // "PENDING_PAYMENT" (stock reservado, esperando el pago) | "COMPLETED" | "CANCELLED"
  status        String     @default("COMPLETED")
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at")

  store         Store      @relation(fields: [storeId], references: [id])
  customer      Customer?  @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  paymentIntents PaymentIntent[]

  @@index([storeId, date])
  @@index([date])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int     @map("sale_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Float   @map("unit_price")
  // Costo al momento de vender: la ganancia no cambia si después se actualiza el costo del producto
  unitCost  Float?  @map("unit_cost")
  subtotal  Float

  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

// Cada intento de cobrar una venta. Una venta puede tener varios (rechazado → reintento).
// status: "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED" | "EXPIRED"
//       | "UNKNOWN" (se perdió la respuesta del proveedor: nunca se asume que falló)
model PaymentIntent {
  id                Int       @id @default(autoincrement())
  saleId            Int       @map("sale_id")
  storeId           Int       @map("store_id")
  method            String    // CASH | CARD | TRANSFER | QR | MIXED
  provider          String    // cash | card-standalone | manual-transfer | qr-simulator | ...
  status            String    @default("PENDING")
  amount            Float
  // Referencia única que viaja al proveedor para vincular el pago con la venta
  reference         String    @unique
  // La genera el navegador: si el mismo cobro llega dos veces, se procesa una sola vez
  idempotencyKey    String    @unique @map("idempotency_key")
  providerPaymentId String?   @map("provider_payment_id")
  qrData            String?   @map("qr_data")
  failureReason     String?   @map("failure_reason")
  expiresAt         DateTime? @map("expires_at")
  createdById       Int       @map("created_by_id")
  confirmedById     Int?      @map("confirmed_by_id")
  resolvedAt        DateTime? @map("resolved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  sale              Sale      @relation(fields: [saleId], references: [id])
  store             Store     @relation(fields: [storeId], references: [id])

  @@index([saleId])
  @@index([storeId, status])
  @@index([status])
  @@map("payment_intents")
}
