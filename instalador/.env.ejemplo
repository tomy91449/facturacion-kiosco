# Configuración de Kiosco Domingo en esta PC.
# instalar.bat completa JWT_SECRET, el nombre del comercio y el administrador la primera vez.
# Si cambiás algo acá, volvé a ejecutar instalar.bat para aplicarlo.

JWT_SECRET=
JWT_EXPIRES_IN=12h

# Impresora de tickets en red (dentro de Docker solo funciona por red, no por USB)
PRINTER_TYPE=tcp
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
PAPER_WIDTH=48

# Datos del comercio (aparecen en el ticket)
STORE_NAME=MI COMERCIO
STORE_ADDRESS=Calle 123, Ciudad
STORE_PHONE=(000) 000-0000
STORE_TAX_ID=00-00000000-0
TICKET_FOOTER=Gracias por su compra!

# Cobro con QR: vacío = deshabilitado, "simulator" = solo pruebas (no entra dinero)
QR_PROVIDER=

# Administrador inicial: se crea en la primera instalación y después la contraseña se borra de acá
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
