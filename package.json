{
  "name": "kiosco-domingo",
  "productName": "Kiosco Domingo",
  "version": "1.1.0",
  "description": "Sistema POS Kiosco Domingo",
  "main": "electron/main.js",
  "author": "Kiosco Domingo",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "licencia": "node scripts/licencias.js"
  },
  "build": {
    "appId": "com.kioscoDomingo.app",
    "productName": "Kiosco Domingo",
    "icon": "public/icon.png",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "dist/generated/client/query_engine-windows.dll.node"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "prisma/migrations/**/*",
      "package.json",
      "!node_modules/prisma/**",
      "!node_modules/@prisma/engines/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "shortcutName": "Kiosco Domingo",
      "artifactName": "Kiosco Domingo Setup ${version}.${ext}"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "serialport": "^12.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5"
  }
}
